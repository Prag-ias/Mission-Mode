# Supabase Postgres — use the pooler URI (Connect → Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The single password that gates the app. No auth library, no users table.
SARTHI_PASSWORD=change-me

# Supabase service_role key (Dashboard → Project Settings → API keys).
# Enables per-topic file uploads. Without it the app runs fine and the upload
# UI states that it is switched off.
SUPABASE_SERVICE_KEY=
